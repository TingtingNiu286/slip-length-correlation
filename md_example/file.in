dimension        3
units            metal
boundary         p p p 
neighbor         3 bin
neigh_modify     every 1 delay 0 check yes
atom_style       full
bond_style       harmonic
angle_style      harmonic
pair_style       hybrid lj/cut/coul/long 10.0 8.0 eam  
kspace_style     pppm 1.0e-4

read_data        mx.data

bond_coeff       1 600 1
angle_coeff      1 75 109.47
pair_coeff       1 1 lj/cut/coul/long 0.0067 3.166
pair_coeff       1 2 lj/cut/coul/long 0.0 0.0
pair_coeff       1 3 lj/cut/coul/long 0.04237 2.66
pair_coeff       2 2 lj/cut/coul/long 0.0 0.0
pair_coeff       2 3 lj/cut/coul/long 0.0 0.0
pair_coeff       3 3 eam Cu_u3.eam
group            water type 1 2
group            cu type 3

region           fix_up block  INF INF INF INF 128 129 units box
region           fix_down block  INF INF INF INF 5 6  units box
region           fix union 2 fix_up fix_down
group            fix region fix

region           thermo_up block  INF INF INF INF 124 128 units box
region           thermo_down block  INF INF INF INF 6 9.5 units box
region           thermo union 2 thermo_up thermo_down
group            thermo region thermo

region           free_up block  INF INF INF INF 93.5 124  units box
region           free_down block  INF INF INF INF 9.5 40 units box
region           free union 2 free_up free_down
group            free region free

min_style        cg 
minimize         1.0e-4 1.0e-6 5000 5000

fix              1 water shake 0.0001 10 0 b 1 a 1             
compute          myTemp water temp
timestep         0.001
thermo           1000
thermo_style     custom step temp c_myTemp pe ke etotal press 
velocity         water create 293.15 1001 temp myTemp rot yes dist gaussian 
dump             2 all custom 100000 run.lammps id mol type x y z
fix              fix_wat water npt temp 293.15 293.15 0.1  iso 1.0 1.0 100
fix_modify       fix_wat temp myTemp
fix              fix_thermo thermo nvt temp 293.15 293.15 0.1
fix              fix_free free nvt temp 293.15 293.15 0.1

run              1000000

unfix            fix_wat
fix              wat_nvt water nvt temp 293.15 293.15 0.1

fix              add water addforce 0.00001 0 0
run              1000000

compute          3 water chunk/atom bin/1d z lower 0.1 units box
fix              4 water ave/chunk 1 2000000 2000000 3 density/mass vx norm sample file Result.txt

run              6000000

